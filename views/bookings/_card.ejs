<%
  const fmt = (d) => d.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
  const isPast = b.status === "confirmed" && b.checkOut <= new Date();
  const label = b.status === "cancelled" ? "cancelled" : (isPast ? "past" : "confirmed");
  const text = b.status === "cancelled" ? "Cancelled" : (isPast ? "Completed" : "Confirmed");
%>
<div class="b-card reveal">
  <img src="<%= b.listing.image && b.listing.image.url %>" alt="<%= b.listing.title %>">
  <div>
    <span class="status <%= label %>"><%= text %></span>
    <h5><%= b.listing.title %></h5>
    <div class="info">
      <span><i class="fa-solid fa-location-dot me-1"></i><%= b.listing.location %>, <%= b.listing.country %></span>
      <span><i class="fa-regular fa-calendar me-1"></i><%= fmt(b.checkIn) %> → <%= fmt(b.checkOut) %></span>
      <span><i class="fa-solid fa-moon me-1"></i><%= b.nights %> night<%= b.nights > 1 ? "s" : "" %></span>
      <span><i class="fa-solid fa-user-group me-1"></i><%= b.guests %> guest<%= b.guests > 1 ? "s" : "" %></span>
      <% if (typeof showGuest !== "undefined" && showGuest && b.guest) { %><span><i class="fa-regular fa-user me-1"></i><%= b.guest.username %> · <%= b.guest.email %></span><% } %>
    </div>
  </div>
  <div class="actions">
    <div class="amt">&#8377;<%= b.totalPrice.toLocaleString("en-IN") %></div>
    <a class="btn btn-ghost btn-sm" href="/bookings/<%= b._id %>">Details</a>
    <% if (b.status === "confirmed" && b.checkIn > new Date()) { %>
      <form method="POST" action="/bookings/<%= b._id %>?_method=DELETE" data-confirm="Cancel this booking?">
        <input type="hidden" name="from" value="<%= typeof from !== 'undefined' ? from : 'trips' %>">
        <button class="btn btn-danger btn-sm w-100" type="submit">Cancel</button>
      </form>
    <% } %>
  </div>
</div>
