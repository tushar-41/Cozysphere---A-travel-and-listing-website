<% layout("/layouts/boilerplate.ejs") %>
<div class="form-shell panel reveal">
  <h2>Edit <span class="grad-text">listing</span></h2>
  <p class="sub">Update details for <%= list.title %>.</p>
  <form method="POST" action="/listings/<%= list.id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
    <div class="mb-3">
      <label for="title" class="form-label">Title</label>
      <input id="title" name="listing[title]" value="<%= list.title %>" type="text" class="form-control" required>
      <div class="invalid-feedback">Please enter a valid title</div>
    </div>
    <div class="mb-3">
      <label for="description" class="form-label">Description</label>
      <textarea id="description" name="listing[description]" rows="5" class="form-control" required><%= list.description %></textarea>
      <div class="invalid-feedback">Please enter a short description!</div>
    </div>
    <div class="mb-3">
      <label class="form-label" for="image">Photo</label>
      <div class="upload">
        <input id="image" name="listing[image]" type="file" accept="image/*" class="form-control" data-preview="#preview">
        <img id="preview" class="has" src="<%= list.image && list.image.url %>" alt="Current photo">
      </div>
    </div>
    <div class="row">
      <div class="mb-3 col-md-4">
        <label for="price" class="form-label">Price / night (₹)</label>
        <input id="price" name="listing[price]" value="<%= list.price %>" type="number" min="0" class="form-control" required>
        <div class="invalid-feedback">Please enter a valid price</div>
      </div>
      <div class="mb-3 col-md-4">
        <label for="category" class="form-label">Category</label>
        <select id="category" name="listing[category]" class="form-select" required>
          <% for (const c of categories) { %><option value="<%= c.slug %>" <%= list.category === c.slug ? "selected" : "" %>><%= c.label %></option><% } %>
        </select>
      </div>
      <div class="mb-3 col-md-4">
        <label for="maxGuests" class="form-label">Max guests</label>
        <input id="maxGuests" name="listing[maxGuests]" type="number" min="1" max="20" value="<%= list.maxGuests || 4 %>" class="form-control" required>
        <div class="invalid-feedback">Enter 1 to 20 guests</div>
      </div>
    </div>
    <div class="row">
      <div class="mb-3 col-md-6">
        <label for="location" class="form-label">Location</label>
        <input id="location" name="listing[location]" value="<%= list.location %>" type="text" class="form-control" required>
        <div class="invalid-feedback">Please enter a valid Location!</div>
      </div>
      <div class="mb-3 col-md-6">
        <label for="country" class="form-label">Country</label>
        <input id="country" name="listing[country]" value="<%= list.country %>" type="text" class="form-control" required>
        <div class="invalid-feedback">Please enter a valid Country name!</div>
      </div>
    </div>
    <button type="submit" class="btn btn-grad mt-2">Save changes</button>
  </form>
</div>
