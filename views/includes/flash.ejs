<div class="flash-stack" role="status" aria-live="polite">
<% if(success && success.length){ for(const msg of [].concat(success)){ %>
  <div class="toast-msg success"><i class="fa-solid fa-circle-check"></i><span><%= msg %></span><button type="button" aria-label="Dismiss">&times;</button></div>
<% }} %>
<% if(error && error.length){ for(const msg of [].concat(error)){ %>
  <div class="toast-msg error"><i class="fa-solid fa-circle-exclamation"></i><span><%= msg %></span><button type="button" aria-label="Dismiss">&times;</button></div>
<% }} %>
</div>
