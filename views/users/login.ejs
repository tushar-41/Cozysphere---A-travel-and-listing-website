<% layout("/layouts/boilerplate.ejs") %>
<div class="auth-shell panel reveal">
  <h2>Welcome <span class="grad-text">back</span></h2>
  <p class="sub">Log in to book stays and manage your trips.</p>
  <form action="/login" method="POST" class="needs-validation" novalidate>
    <div class="mb-3">
      <label for="username" class="form-label">Username</label>
      <input name="username" id="username" placeholder="Enter username" type="text" class="form-control" autocomplete="username" required>
      <div class="invalid-feedback">Please provide username</div>
    </div>
    <div class="mb-3">
      <label for="password" class="form-label">Password</label>
      <input name="password" id="password" placeholder="Enter password" type="password" class="form-control" autocomplete="current-password" required>
      <div class="invalid-feedback">Please provide password</div>
    </div>
    <button type="submit" class="btn btn-grad w-100 mt-2">Log in</button>
  </form>
  <p class="fine mt-3">New here? <a href="/signup">Create an account</a></p>
</div>
